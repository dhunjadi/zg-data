{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "GOOGLE_MAPS_ANDROID_KEY": "GOOGLE_MAPS_ANDROID_KEY",
        "GOOGLE_MAPS_IOS_KEY": "GOOGLE_MAPS_IOS_KEY"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "GOOGLE_MAPS_ANDROID_KEY": "GOOGLE_MAPS_ANDROID_KEY",
        "GOOGLE_MAPS_IOS_KEY": "GOOGLE_MAPS_IOS_KEY"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "GOOGLE_MAPS_ANDROID_KEY": "GOOGLE_MAPS_ANDROID_KEY",
        "GOOGLE_MAPS_IOS_KEY": "GOOGLE_MAPS_IOS_KEY"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
